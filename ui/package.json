{
	"name": "raid-comp-ui",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"prepare": "yarn smui-theme-dark",
		"smui-theme-light": "smui-theme compile static/smui-light.css -i src/theme/light",
		"smui-theme-dark": "smui-theme compile static/smui-dark.css -i src/theme/dark"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@haverstack/axios-fetch-adapter": "0.12.0",
		"@smui-extra/bottom-app-bar": "^9.0.6",
		"@smui/button": "^9.0.6",
		"@smui/card": "^9.0.6",
		"@smui/circular-progress": "^9.0.6",
		"@smui/common": "^9.0.6",
		"@smui/dialog": "^9.0.6",
		"@smui/fab": "^9.0.6",
		"@smui/icon-button": "^9.0.6",
		"@smui/layout-grid": "^9.0.6",
		"@smui/list": "9.0.6",
		"@smui/menu": "^9.0.6",
		"@smui/paper": "^9.0.6",
		"@smui/segmented-button": "^9.0.6",
		"@smui/select": "9.0.6",
		"@smui/snackbar": "^9.0.6",
		"@smui/textfield": "^9.0.6",
		"@smui/tooltip": "^9.0.6",
		"@sveltejs/adapter-cloudflare": "^9.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@typescript-eslint/eslint-plugin": "^8.58.1",
		"@typescript-eslint/parser": "^8.58.1",
		"axios": "1.21.1",
		"axios-mock-adapter": "^2.1.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.0.0",
		"smui-theme": "^9.0.6",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"svelte-turnstile": "0.11.0",
		"tslib": "^2.8.1",
		"typescript": "~6.0.0",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.12",
		"wrangler": "4.164.0"
	},
	"type": "module",
	"dependencies": {
		"svelte-i18n": "^4.0.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
